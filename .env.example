# =============================================================================
# Modele de configuration — Zlobodan Couverture
#
# Copier en `.env` et renseigner. Ce fichier est versionne : il ne doit
# contenir QUE des valeurs d exemple, jamais un secret reel.
#
# En production, l absence d un secret interrompt le demarrage du serveur
# (voir src/lib/security/env.ts). C est volontaire : une protection qui se
# degrade en silence est pire qu une protection absente.
# =============================================================================

# --- Base de donnees ---------------------------------------------------------
# `sslmode=require` est EXIGE en production : le chiffrement en transit vers la
# base n est pas optionnel.
DATABASE_URL="postgres://zlobodan_app:motdepasse@localhost:5432/zlobodan?sslmode=require"

# Compte distinct, utilise uniquement au deploiement pour les migrations.
# Il possede les droits DDL que le compte applicatif n a pas.
MIGRATION_DATABASE_URL="postgres://zlobodan_migrate:motdepasse@localhost:5432/zlobodan?sslmode=require"

# Base ISOLEE pour les tests d integration. En mode test (NODE_ENV=test), la
# configuration refuse toute DATABASE_URL non locale : fournir cette variable
# vers une base jetable empeche une suite de tests d ecrire dans une base
# reelle. L hote doit etre local (localhost / 127.0.0.1) ou un service CI.
# TEST_DATABASE_URL="postgres://postgres:postgres@localhost:5432/zlobodan_test"

# --- Secrets applicatifs -----------------------------------------------------
# 32 caracteres minimum chacun. Generer avec : openssl rand -base64 48
SESSION_SECRET="remplacer_par_une_valeur_aleatoire_de_32_caracteres_minimum"

# Sel HMAC d anonymisation des adresses IP dans le journal d audit.
# Sans sel secret, l espace IPv4 se force en quelques minutes.
IP_HASH_SALT="remplacer_par_une_valeur_aleatoire_de_32_caracteres_minimum"

# --- Origine canonique -------------------------------------------------------
# Les liens transactionnels (verification email, reinitialisation) sont
# construits a partir de cette valeur, JAMAIS de l en-tete `Host` recu : sinon
# un attaquant se fait envoyer le jeton d un tiers en falsifiant `Host`.
APP_ORIGIN="https://zlobodan-couverture.be"

# --- Proxy de confiance ------------------------------------------------------
# `cloudflare` fait lire l IP cliente depuis `CF-Connecting-IP`.
# A n activer QU APRES avoir restreint le pare-feu de l origine aux plages du
# CDN : sans cela, cet en-tete est falsifiable par n importe qui.
TRUSTED_PROXY="cloudflare"

# --- Anti-automate Cloudflare Turnstile --------------------------------------
# Les valeurs ci-dessous sont les cles de TEST publiques de Cloudflare :
# elles valident tous les jetons. La cle secrete de test est explicitement
# REFUSEE en production par la validation d environnement.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# --- Limitation de debit partagee (Upstash Redis) ----------------------------
# Sans stockage partage, le compteur redevient local a chaque instance : il ne
# limite plus rien au-dela d un seul processus.
UPSTASH_REDIS_REST_URL="https://exemple.upstash.io"
UPSTASH_REDIS_REST_TOKEN="remplacer_par_le_jeton_upstash"

# --- SMTP --------------------------------------------------------------------
# ATTENTION : aucun transport email n est branche a ce jour. Ces variables sont
# documentees pour le raccordement a venir ; en l etat, les alertes de securite
# sont construites et journalisees mais ne partent pas.
# Voir SECURITY.md, section « Risques residuels assumes ».
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT="587"
SMTP_USER="smtp_username"
SMTP_PASS="remplacer_par_le_mot_de_passe_smtp"
EMAIL_FROM="Zlobodan Couverture <no-reply@zlobodan-couverture.be>"
