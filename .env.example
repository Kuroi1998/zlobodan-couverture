# Base de données PostgreSQL (Drizzle ORM / Supabase / Neon)
DATABASE_URL="postgres://postgres:postgres@localhost:5432/zlobodan"

# Hachage d'IP & Sel de Sécurité
IP_HASH_SALT="change_me_to_a_random_sha256_salt_in_production_2026"

# Clef de Secours Session JWT / Cookie
SESSION_SECRET="super_secret_cookie_signing_key_min_32_chars_long"

# Cloudflare Turnstile CAPTCHA (Protection Bruteforce)
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# Configuration SMTP (Notification Email)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT="587"
SMTP_USER="smtp_username"
SMTP_PASS="smtp_password"
EMAIL_FROM="Zlobodan Couverture <no-reply@zlobodan-couverture.be>"
