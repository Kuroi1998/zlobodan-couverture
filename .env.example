# Configuration d'exemple uniquement. Ne jamais versionner de secret réel.

# PostgreSQL. `sslmode=require` ou `verify-full` est exigé en production.
DATABASE_URL="postgres://zlobodan_app:motdepasse@localhost:5432/zlobodan?sslmode=require"
MIGRATION_DATABASE_URL="postgres://zlobodan_migrate:motdepasse@localhost:5432/zlobodan?sslmode=require"
# TEST_DATABASE_URL="postgres://postgres:postgres@localhost:5432/zlobodan_test"
# E2E_DATABASE_URL="postgres://postgres:postgres@localhost:5432/zlobodan_e2e_test"

# Secrets de 32 caractères minimum. Générer par exemple avec openssl rand -base64 48.
SESSION_SECRET="remplacer_par_une_valeur_aleatoire_de_32_caracteres_minimum"
IP_HASH_SALT="remplacer_par_une_valeur_aleatoire_de_32_caracteres_minimum"
APP_ORIGIN="https://zlobodan-couverture.be"

# N'activer Cloudflare qu'après avoir limité le pare-feu de l'origine au CDN.
TRUSTED_PROXY="cloudflare"

# Cloudflare Turnstile. Les valeurs ci-dessous sont les clés de test officielles.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# Limitation de débit partagée, requise pour plusieurs instances.
UPSTASH_REDIS_REST_URL="https://exemple.upstash.io"
UPSTASH_REDIS_REST_TOKEN="remplacer_par_le_jeton_upstash"

# SMTP. Planifier `npm run notifications:dispatch` toutes les minutes.
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="smtp_username"
SMTP_PASS="remplacer_par_le_mot_de_passe_smtp"
EMAIL_FROM="Zlobodan Couverture <no-reply@zlobodan-couverture.be>"

# Stockage privé. `local` est refusé au runtime de production.
UPLOAD_STORAGE_DRIVER="local"
LOCAL_UPLOAD_DIRECTORY="storage/uploads"

# Requis lorsque UPLOAD_STORAGE_DRIVER=s3.
S3_ENDPOINT="https://s3.eu-central-1.amazonaws.com"
S3_REGION="eu-central-1"
S3_BUCKET="zlobodan-private-uploads"
S3_ACCESS_KEY_ID="remplacer_par_l_identifiant"
S3_SECRET_ACCESS_KEY="remplacer_par_le_secret"
S3_FORCE_PATH_STYLE="false"
