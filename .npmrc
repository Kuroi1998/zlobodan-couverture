# Les scripts postinstall sont le principal vecteur de compromission npm :
# un paquet compromis execute du code arbitraire des l installation, avant
# meme que la moindre ligne du projet ne tourne. Ils sont donc desactives par
# defaut. Si un paquet en a reellement besoin (esbuild, sharp), l autoriser
# explicitement plutot que de reactiver globalement.
ignore-scripts=true

# Le lockfile fait foi : refus d installer une version non verrouillee.
save-exact=false
engine-strict=true
audit-level=critical
