<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600" width="100%" height="100%">
  <rect width="800" height="600" fill="#292524"/>
  <!-- Red Tile Pattern -->
  <g fill="#C2410C" stroke="#7C2D12" stroke-width="3">
    <path d="M 50 180 Q 100 150 150 180 L 150 250 Q 100 220 50 250 Z"/>
    <path d="M 160 180 Q 210 150 260 180 L 260 250 Q 210 220 160 250 Z"/>
    <path d="M 270 180 Q 320 150 370 180 L 370 250 Q 320 220 270 250 Z"/>
    <path d="M 380 180 Q 430 150 480 180 L 480 250 Q 430 220 380 250 Z"/>
    <path d="M 490 180 Q 540 150 590 180 L 590 250 Q 540 220 490 250 Z"/>
    <path d="M 600 180 Q 650 150 700 180 L 700 250 Q 650 220 600 250 Z"/>
    
    <path d="M 100 240 Q 150 210 200 240 L 200 310 Q 150 280 100 310 Z"/>
    <path d="M 210 240 Q 260 210 310 240 L 310 310 Q 260 280 210 310 Z"/>
    <path d="M 320 240 Q 370 210 420 240 L 420 310 Q 370 280 320 310 Z"/>
    <path d="M 430 240 Q 480 210 530 240 L 530 310 Q 480 280 430 310 Z"/>
    <path d="M 540 240 Q 590 210 640 240 L 640 310 Q 590 280 540 310 Z"/>
  </g>
  <!-- Overlay Label -->
  <rect x="40" y="480" width="450" height="80" rx="8" fill="#0F172A" opacity="0.95"/>
  <text x="60" y="515" font-family="Arial" font-weight="bold" font-size="20" fill="#FFFFFF">Pose de Tuiles Terre Cuite Terreal</text>
  <text x="60" y="540" font-family="Arial" font-size="14" fill="#EA580C">Chantier Orvault — Écran sous-toiture HPV</text>
</svg>
