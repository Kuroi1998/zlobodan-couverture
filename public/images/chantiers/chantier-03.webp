<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600" width="100%" height="100%">
  <rect width="800" height="600" fill="#064E3B"/>
  <rect width="400" height="600" fill="#78350F"/>
  <line x1="400" y1="0" x2="400" y2="600" stroke="#EA580C" stroke-width="4"/>
  <!-- Tiles dirty side -->
  <g fill="#92400E" stroke="#451A03" stroke-width="2">
    <rect x="40" y="150" width="80" height="40" rx="3"/>
    <rect x="130" y="150" width="80" height="40" rx="3"/>
    <rect x="220" y="150" width="80" height="40" rx="3"/>
    <rect x="310" y="150" width="80" height="40" rx="3"/>
    <circle cx="80" cy="170" r="12" fill="#15803D" opacity="0.8"/>
    <circle cx="250" cy="170" r="15" fill="#15803D" opacity="0.8"/>
  </g>
  <!-- Tiles clean side -->
  <g fill="#EA580C" stroke="#9A3412" stroke-width="2">
    <rect x="420" y="150" width="80" height="40" rx="3"/>
    <rect x="510" y="150" width="80" height="40" rx="3"/>
    <rect x="600" y="150" width="80" height="40" rx="3"/>
    <rect x="690" y="150" width="80" height="40" rx="3"/>
    <!-- Water drops perlant effect -->
    <circle cx="460" cy="165" r="4" fill="#60A5FA"/>
    <circle cx="550" cy="170" r="5" fill="#60A5FA"/>
    <circle cx="640" cy="160" r="4" fill="#60A5FA"/>
  </g>
  <!-- Labels -->
  <rect x="50" y="50" width="160" height="40" rx="20" fill="#451A03" opacity="0.9"/>
  <text x="130" y="75" font-family="Arial" font-weight="bold" font-size="16" fill="#FCA5A5" text-anchor="middle">AVANT (Mousse)</text>
  
  <rect x="590" y="50" width="160" height="40" rx="20" fill="#064E3B" opacity="0.9"/>
  <text x="670" y="75" font-family="Arial" font-weight="bold" font-size="16" fill="#6EE7B7" text-anchor="middle">APRÈS (Hydrofuge)</text>

  <rect x="40" y="480" width="480" height="80" rx="8" fill="#0F172A" opacity="0.95"/>
  <text x="60" y="515" font-family="Arial" font-weight="bold" font-size="20" fill="#FFFFFF">Démoussage &amp; Hydrofuge Rénovateur</text>
  <text x="60" y="540" font-family="Arial" font-size="14" fill="#EA580C">Chantier Rezé — Protection Effet Perlant 10 ans</text>
</svg>
