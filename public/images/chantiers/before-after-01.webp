<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600" width="100%" height="100%">
  <rect width="800" height="600" fill="#0F172A"/>
  <rect width="400" height="600" fill="#334155"/>
  <line x1="400" y1="0" x2="400" y2="600" stroke="#EA580C" stroke-width="4"/>
  <!-- Avant: abimé -->
  <text x="200" y="250" font-family="Arial" font-weight="bold" font-size="24" fill="#94A3B8" text-anchor="middle">Toiture usagée</text>
  <text x="200" y="280" font-family="Arial" font-size="16" fill="#F87171" text-anchor="middle">Tuiles cassées &amp; fuites</text>
  <!-- Après: rénové -->
  <text x="600" y="250" font-family="Arial" font-weight="bold" font-size="24" fill="#FFFFFF" text-anchor="middle">Toiture rénovée</text>
  <text x="600" y="280" font-family="Arial" font-size="16" fill="#4ADE80" text-anchor="middle">Ardoise &amp; Zinc neuf</text>
  <!-- Badges -->
  <rect x="50" y="50" width="140" height="40" rx="20" fill="#7F1D1D"/>
  <text x="120" y="75" font-family="Arial" font-weight="bold" font-size="16" fill="#FFFFFF" text-anchor="middle">AVANT</text>
  <rect x="610" y="50" width="140" height="40" rx="20" fill="#14532D"/>
  <text x="680" y="75" font-family="Arial" font-weight="bold" font-size="16" fill="#FFFFFF" text-anchor="middle">APRÈS</text>
</svg>
