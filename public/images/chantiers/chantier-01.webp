<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600" width="100%" height="100%">
  <rect width="800" height="600" fill="#1E293B"/>
  <!-- Roof Slate Pattern -->
  <g fill="#334155" stroke="#0F172A" stroke-width="2">
    <rect x="50" y="200" width="100" height="60" rx="4"/>
    <rect x="160" y="200" width="100" height="60" rx="4"/>
    <rect x="270" y="200" width="100" height="60" rx="4"/>
    <rect x="380" y="200" width="100" height="60" rx="4"/>
    <rect x="490" y="200" width="100" height="60" rx="4"/>
    <rect x="600" y="200" width="100" height="60" rx="4"/>
    
    <rect x="105" y="250" width="100" height="60" rx="4"/>
    <rect x="215" y="250" width="100" height="60" rx="4"/>
    <rect x="325" y="250" width="100" height="60" rx="4"/>
    <rect x="435" y="250" width="100" height="60" rx="4"/>
    <rect x="545" y="250" width="100" height="60" rx="4"/>
    <rect x="655" y="250" width="100" height="60" rx="4"/>
  </g>
  <!-- Zinc Gouttière nantaise -->
  <rect x="40" y="310" width="720" height="25" fill="#94A3B8" rx="3"/>
  <circle cx="150" cy="322" r="3" fill="#475569"/>
  <circle cx="350" cy="322" r="3" fill="#475569"/>
  <circle cx="550" cy="322" r="3" fill="#475569"/>
  <!-- Overlay Label -->
  <rect x="40" y="480" width="400" height="80" rx="8" fill="#0F172A" opacity="0.95"/>
  <text x="60" y="515" font-family="Arial" font-weight="bold" font-size="20" fill="#FFFFFF">Réfection Ardoise &amp; Zinguerie Nantaise</text>
  <text x="60" y="540" font-family="Arial" font-size="14" fill="#EA580C">Chantier Nantes Procé — Garantie Décennale</text>
</svg>
