{
  "name": "zlobodan-couverture",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11.10 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/db/seed.ts",
    "check:size": "node scripts/check-size.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:bundle": "node scripts/check-client-bundle.js",
    "db:migrate": "drizzle-kit migrate",
    "typecheck": "tsc --noEmit",
    "lint:strict": "eslint . --max-warnings 0",
    "validate": "npm run typecheck && npm run lint:strict && npm run check:size && npm run test && npm run build"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "leaflet": "1.9.4",
    "lucide-react": "^0.378.0",
    "next": "^16.2.10",
    "postgres": "^3.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.3",
    "speakeasy": "^2.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20.12.11",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.0",
    "@types/speakeasy": "^2.0.10",
    "autoprefixer": "^10.4.19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.10",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "tsx": "^4.10.2",
    "typescript": "^5.4.5",
    "vitest": "^4.1.10"
  }
}
