{
  "name": "zlobodan-couverture",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11.10 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "db:generate": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs generate",
    "db:push": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs push",
    "db:seed": "tsx --env-file-if-exists=.env.local --tsconfig tsconfig.scripts.json src/db/seed.ts",
    "check:size": "node scripts/check-size.js",
    "test": "vitest run",
    "test:integration": "node scripts/run-integration-tests.cjs",
    "test:e2e": "node scripts/run-e2e-tests.cjs",
    "test:restart": "node scripts/run-restart-persistence-test.cjs",
    "test:watch": "vitest",
    "check:bundle": "node scripts/check-client-bundle.js",
    "db:migrate": "tsx --env-file-if-exists=.env.local --tsconfig tsconfig.scripts.json scripts/migrate-database.ts",
    "typecheck": "tsc --noEmit",
    "lint:strict": "eslint . --max-warnings 0",
    "validate": "npm run typecheck && npm run lint:strict && npm run check:size && npm run test && npm run build",
    "validate:full": "npm run validate && npm run test:integration && npm run test:e2e",
    "env:check": "tsx --env-file-if-exists=.env.local --tsconfig tsconfig.scripts.json scripts/check-environment.ts",
    "db:check": "tsx --env-file-if-exists=.env.local --tsconfig tsconfig.scripts.json scripts/check-database.ts",
    "notifications:dispatch": "tsx --env-file-if-exists=.env.local --tsconfig tsconfig.scripts.json scripts/dispatch-notifications.ts",
    "auth:rotate-encryption-key": "tsx --env-file-if-exists=.env.local --tsconfig tsconfig.scripts.json scripts/rotate-auth-encryption-key.ts",
    "uploads:cleanup": "tsx --env-file-if-exists=.env.local --tsconfig tsconfig.scripts.json scripts/cleanup-orphaned-uploads.ts",
    "drafts:cleanup": "tsx --env-file-if-exists=.env.local --tsconfig tsconfig.scripts.json scripts/cleanup-expired-drafts.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1090.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "leaflet": "1.9.4",
    "lucide-react": "^0.378.0",
    "next": "16.2.12",
    "nodemailer": "^9.0.3",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.4",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "drizzle-kit": "^0.31.10",
    "esbuild": "0.28.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.11",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "tsx": "^4.10.2",
    "typescript": "^5.4.5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "$sharp"
  }
}
